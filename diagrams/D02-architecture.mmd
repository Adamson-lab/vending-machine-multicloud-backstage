  C --> A2["generated/gcp.tfvars.json"]
  C --> A3["generated/aft/*.tf"]
  C --> A4["generated/catalog/*.yaml"]
  A1 --> S1["Azure stack: subscription vending module"]
  A2 --> S2["GCP stack: project vending module"]
  A3 --> S3["AFT account request repo"]
  S3 --> AC["AFT customizations: aws-account-baseline"]
  A4 --> CA["Backstage catalog: one Resource per container"]
  R --> O["OPA approval routing"]
  O --> L["PR labels and approval gate"]
