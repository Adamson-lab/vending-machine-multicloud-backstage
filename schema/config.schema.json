{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vending machine configuration",
  "type": "object",
  "required": ["schema_version", "organization", "limits", "approvals", "placements", "gcp", "aws"],
  "properties": {
    "schema_version": {"const": 1},
    "organization": {
      "type": "object",
      "required": ["name", "email_domain", "jurisdictions"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "email_domain": {"type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"},
        "jurisdictions": {"type": "array", "minItems": 1, "items": {"enum": ["eu", "us", "uk"]}}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["sandbox_max_budget_usd", "sandbox_max_ttl_days", "budget_thresholds_percent"],
      "properties": {
        "sandbox_max_budget_usd": {"type": "number", "exclusiveMinimum": 0},
        "sandbox_max_ttl_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "budget_thresholds_percent": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 200}}
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["finance_budget_threshold_usd"],
      "properties": {"finance_budget_threshold_usd": {"type": "number", "minimum": 0}},
      "additionalProperties": false
    },
    "placements": {
      "type": "object",
      "required": ["aws", "azure", "gcp"],
      "properties": {
        "aws": {"type": "object", "required": ["prod", "nonprod", "dev", "sandbox", "decommissioning"], "additionalProperties": {"type": "string"}},
        "azure": {"type": "object", "required": ["corp", "online", "sandbox", "decommissioning"], "additionalProperties": {"type": "string"}},
        "gcp": {"type": "object", "required": ["prod", "nonprod", "dev", "sandbox", "decommissioning"], "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "gcp": {
      "type": "object",
      "required": ["default_apis"],
      "properties": {"default_apis": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+\\.googleapis\\.com$"}}},
      "additionalProperties": false
    },
    "aws": {
      "type": "object",
      "required": ["customizations"],
      "properties": {"customizations": {"type": "object", "required": ["standard", "restricted"], "additionalProperties": {"type": "string"}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
